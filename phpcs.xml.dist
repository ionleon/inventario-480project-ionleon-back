<?xml version="1.0"?>
<ruleset name="App">
    <description>PSR-12 + minimal extras for this project.</description>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>tests/Support/_generated/*</exclude-pattern>
    <exclude-pattern>var/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <arg value="np"/>

    <rule ref="PSR12">
        <!-- Class names mirror Symfony / DDD conventions where short namespace
             segments (e.g. App, DTO, VO) are common; PSR-12 doesn't forbid them
             but the default sniffer warns on them. Keep them. -->
    </rule>

    <!-- Allow PHPUnit data-provider style and Cest style test method names. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Codeception Cest lifecycle hooks (_before, _after, _failed) require the
         underscore prefix by framework contract — they are not visibility hints. -->
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>tests/Api/*</exclude-pattern>
        <exclude-pattern>tests/Functional/*</exclude-pattern>
    </rule>
</ruleset>

<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Core\Domain\Model\Aggregate\User" table="app_user">

        <id name="id" type="user_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="email" type="user_email" column="email" length="150" unique="true"/>
        <field name="name" type="user_name" column="name" length="100"/>
        <field name="surname" type="user_surname" column="surname" length="100"/>
        <field name="password" type="user_password" column="password" length="255"/>
        <field name="role" type="string" column="role" length="255" enum-type="App\Shared\Domain\Enum\SystemRole"/>
        <field name="isActive" type="boolean" column="is_active"/>
        <field name="firstTime" type="boolean" column="first_time"/>

    </entity>

</doctrine-mapping>

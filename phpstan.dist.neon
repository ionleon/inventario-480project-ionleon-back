parameters:
    level: 6
    reportUnmatchedIgnoredErrors: false
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        analyse:
            # Codeception regenerates these traits on each `codecept build` (~280KB
            # each). They are valid PHP and analyzed so Tester methods resolve, but
            # we don't report errors found inside them — they are not our source.
            - tests/Support/_generated/
    ignoreErrors:
        # OrmRefreshTokenRepository extends ServiceEntityRepository AND implements
        # the bundle's RefreshTokenRepositoryInterface. Both parametrize
        # ObjectRepository's template T differently (RefreshToken vs
        # RefreshTokenInterface). The conflict is structural and forced by the
        # bundle. Documented in the class doc + deviations doc.
        - identifier: generics.interfaceConflict
          path: src/Core/Infrastructure/Persistence/Doctrine/ORM/OrmRefreshTokenRepository.php
        - identifier: missingType.generics
          path: src/Core/Infrastructure/Persistence/Doctrine/ORM/OrmRefreshTokenRepository.php
        - message: '#specifies template type T of interface Doctrine\\Persistence\\ObjectRepository#'
          path: src/Core/Infrastructure/Persistence/Doctrine/ORM/OrmRefreshTokenRepository.php
